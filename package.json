{
  "name": "family-tracking-card",
  "version": "0.4.0",
  "description": "Lovelace card showing Home Assistant persons on a map with a readable stay timeline.",
  "author": "Alexander Hruza",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "rollup": "^4.34.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
